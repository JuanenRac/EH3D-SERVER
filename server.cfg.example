# EH3D-SERVER settings. Copy to server.cfg (or give another file with --config). Every key is optional; an unknown key is an error.
#
# Where the server listens. The default is this computer only (127.0.0.1:18200): 18200 is its own port (ARMOR and HYDRA-UMC use others on the same machine).
# Nodes, the CM5 programs and other computers can reach the server only when it listens on the network: write listen = 0.0.0.0:18200 here, or turn on the switch
# network_open below. Behind the HTTPS proxy of docs/DEPLOY.md keep this computer only and set login_ip_limit = 0.
listen = 127.0.0.1:18200
# Open the server to the network: when listen is an address of this computer only, listen on every address of the computer (same port). Off by default; a switch of the
# security page of Studio (PUT /api/v1/auth/policy) that is read when the server starts. An address written in listen on purpose is never narrowed.
network_open = false
# Where users, tokens, machines and jobs are kept. Back this folder up.
data_dir = data
# How long a login lasts, in hours.
session_hours = 12
# The largest request (a job with its files), in megabytes.
max_body_mb = 8
# How many finished jobs the list keeps.
keep_jobs = 200
# A folder with the pages of EH3D-STUDIO to serve at / (the configuration panel of this server). Empty: only the API.
studio_dir =
# The folder where the server and the update helper (deploy/eh3d-update.py) meet; with it the Studio can check GitHub for newer releases and update. Empty: no updates.
updates_dir =
# Whether an update may be installed with no signature when its hash is right. Off by default: the helper of the updates (deploy/eh3d-update.py) installs only what is signed by
# one of the allowed signers of the machine (/etc/eh3d-update.signers). A switch of the security page of Studio; the server passes it to the helper with each update.
update_allow_unsigned = false
# Whether the logins survive the restart of an update of the server. Off by default: the restart logs everybody out (unless persist_sessions is on). On, the server keeps the SHA-256
# of each login (never the token) in the data folder when an update of the server is asked for, and takes them up again only if it starts within update_keep_logins_s seconds. A switch of the security page of Studio.
update_keep_logins = false
# How long, in seconds, the logins kept for an update stay good (30 to 900).
update_keep_logins_s = 300
# How long, in seconds, a G-code job waits for the machine to finish its last moves (the controller takes lines ahead of the movement) before the job is marked as failed.
gcode_finish_wait_s = 900
# How long, in seconds, a GRBL machine may take to answer a line of a G-code job. When a line does not end in time the machine is held (a homing cycle is reset, a jog is cancelled) and the job is marked as failed, with the line.
# An ordinary line is taken at once.
grbl_line_timeout_s = 5
# How many lines before the one it had reached a resumed G-code job starts again (0 to 1000): the controller takes lines ahead of the movement, so the last ones sent were not all done.
resume_margin_lines = 16
# How many wrong passwords in a row, with any names, block the address they come from for a while (0 to 1000; 0 turns it off). The address is the one of the connection: behind a reverse proxy it is the proxy's, so turn it off there.
login_ip_limit = 10
# Accept the token of the session in the address of the camera and of the websocket (the first versions of the clients sent it there). Off by default: the clients ask for a ticket (POST /api/v1/tickets), good for one use within 30 seconds.
url_token = false
# While the server has no user yet, answer only connections from this very computer (127.0.0.1), so that nobody else on the network can make the first administrator. Off by default (the server answers whoever reaches it); once there is a user it makes no difference.
local_until_setup = false
# The homing cycle ($H, on a machine that allows the $ lines) answers only when the machine has finished; give it more than the longest homing takes.
grbl_homing_timeout_s = 120
# A jog ($J=...) answers when the move is done: give it more than the longest slow move you send.
grbl_jog_timeout_s = 60
# What the server does when a thread of it panics: true stops the machines that are running and exits, so that the service manager (Restart=on-failure) starts it again with its data in order; false only writes the panic to the console and goes on. The conservative choice is true.
exit_on_panic = true
# Take the address of a client from the X-Forwarded-For header, but only on a connection that comes from 127.0.0.1 (the reverse proxy of docs/DEPLOY.md on this very computer); the address the proxy put last is used. Off by default: the address of the socket is the one that counts, and a client that reaches the server directly cannot choose it by writing the header. With it on behind the proxy, login_ip_limit counts each person's own address instead of the proxy's.
trust_forwarded_for = false
# Keep the logins in the data folder (sessions.json, only the SHA-256 of each token) so that a restart of the server (an update, a power cut) does not log anybody out. Off by default: every restart logs everybody out and the file is removed.
persist_sessions = false
# How many days a token of a program lasts when the request that makes it gives no number (0 to 3650; 0: it does not expire). A request can always give its own number of days.
token_default_days = 0
# The websocket of the events sends a ping every events_ping_s seconds (1 to 3600) and is closed when nothing at all, not even the answer to a ping, has come for events_idle_s seconds (longer than events_ping_s).
events_ping_s = 30
events_idle_s = 90
# Write the audit (who did what: logins, jobs, machines, users, tokens, updates) to audit.jsonl in the data folder, one JSON object per line, besides the console. Off: only the console (the journal of the service) has it.
audit_file = true
# Write a line at the start and at the end of every job to eh3d-jobs.log in the data folder (which file, which machine and connection, how it ended, how long it took against the estimate), for diagnosing failures afterwards.
job_log = true
# The size in kilobytes (16 to 1048576) at which audit.jsonl and eh3d-jobs.log are set aside as <name>.1 (one older copy is kept) and a new file starts.
log_max_kb = 1024
# The most places a request may name in the rack of a drilling or routing job, in rack.first and in the entries of rack.slots (1 to 14, the tool changer of the machines has fourteen).
rack_max_slots = 14

# ---- the computing tasks, the uploads, the artifacts and the sharing (docs/API.md)
# Whether the server takes computing tasks at all (/api/v1/tasks). The tasks have no effect on any machine. Off: the routes answer 501 tasks_off.
tasks_enabled = true
# Whether the engine that exercises the task system (server.selftest) is there. Off: only the engines of the design suite are.
tasks_selftest = false
# How many tasks may be waiting or running, all users together (1 to 100000), and how many finished tasks the list keeps (0 to 100000).
max_tasks = 100
keep_tasks = 200
# How many tasks run at the same time (1 to 64), the longest a task may run in seconds (1 to 604800), how many tasks one user may have waiting or running (1 to 10000) and the largest parameters of a task in kilobytes (1 to 65536).
max_concurrent_tasks = 2
task_timeout_s = 600
tasks_per_user = 10
task_params_kb = 64
# How long, in seconds (60 to 2592000), a request that carries an idempotency key is remembered.
idempotency_ttl_s = 86400
# The most the artifact store holds, in gigabytes (1 to 100000, each blob counted once), and the largest artifact or upload, in megabytes (1 to 65536).
artifact_store_gb = 4
max_upload_mb = 512
# How long, in seconds (60 to 2592000), an upload nobody touches is kept, and how many uploads one person may have open (1 to 1000).
upload_ttl_s = 86400
uploads_per_user = 4
# How many days an artifact that nothing points to is kept (0 to 36500; 0: for ever).
artifact_unreferenced_days = 30
# Whether a project or an artifact can be shared with other people at all. Off: only the owner and the administrators see anything.
shares_enabled = true

# ---- the project store of every application (docs/PROJECT_STORE.md)
# The largest file of a project, in megabytes (1 to 4096), and the most a project may hold counting every distinct version once (1 to 65536).
project_max_file_mb = 64
project_max_mb = 512
# The most files of a project, the most projects of one application, and how many versions of a file are kept (0: all of them).
project_max_files = 2000
project_max_projects = 1000
project_versions_kept = 50
# The longest an editing lock lasts without being renewed, in seconds (10 to 86400).
project_lock_ttl_s = 300
# A write over a file that exists needs If-Match with the tag of the version it was made from (428 without it). Turning this off lets a client overwrite a version it never saw.
project_require_if_match = true
# Team mode: everybody with access to the store sees and writes the projects of the application. Off: only the owner of a project and the administrators.
project_shared = false

# ---- the shared catalogs (docs/CATALOGS.md)
# The largest dataset an administrator may upload to a catalog, in megabytes (1 to 1024), the most items of a dataset, and the most items one page answers with.
catalog_max_mb = 16
catalog_max_items = 100000
catalog_page_max = 200

# ---- the generic work of the machines and the stream of events (docs/MACHINE_PLUGINS.md)
# How many jobs of the generic queue may wait, all machines together, and how many finished ones are kept.
work_queue_max = 200
work_keep = 500
# How many clients may listen to the stream of events (GET /api/v1/events/stream) at once, how many events it keeps for a client that reconnects with Last-Event-ID (16 to 65536; also how far a client may fall behind), and how many notifications are kept.
events_clients_max = 32
events_queue = 256
notifications_keep = 200

# ---- the single login of every application (docs/AUTH.md)
# Only the known applications (docs/AUTH.md) and the ones named in auth_extra_apps (names separated by commas) may log in or have a store. Off: any well-formed name.
auth_known_apps_only = true
auth_extra_apps =
# How many logins of the applications one person may have open at once (0: no limit); the oldest is closed when a new one comes.
auth_max_sessions = 20
# How many wrong passwords in a row block a name (1 to 100), the first block in seconds (it doubles while they go on), and the longest a login can be renewed in all, in hours from the moment it was made.
auth_max_failures = 5
auth_lockout_s = 30
auth_refresh_max_hours = 168
# What a password has to be: the shortest (8 to 128), how many of the four classes (lower case, upper case, digits, anything else) it needs (1 to 4), and whether it may contain the name of the person (names of four characters or more).
password_min_len = 8
password_classes = 1
password_deny_name = true
# Write a line to the audit for every request refused with 401 or 403 (the method, the path and the address; never the query).
audit_denials = true

# ---- running the design program for the pcb application (docs/DESIGN_RUN.md)
# Whether the server may run the design program on a board of a project (POST /api/v1/apps/pcb/jobs). Off by default; a switch of the security page. Without it the route answers 501 design_run_unavailable.
design_run = false
# The full path of the program (never looked up in the search path of the system). Empty: not set.
design_program =
# The program is stopped after this many seconds (1 to 3600), and may write at most this many kilobytes to each output (1 to 65536); the rest is dropped.
design_timeout_s = 120
design_max_output_kb = 4096

# ---- the certificate in front of the server
# The certificate (PEM) the reverse proxy shows, so that GET /api/v1/auth/keys can tell its SHA-256 fingerprint. The server does not terminate TLS itself. Empty: none.
tls_cert_file =

# EH3D-SERVER settings. Copy to server.cfg (or give another file with --config). Every key is optional; an unknown key is an error.
#
# Where the server listens. 18200 is its own port (ARMOR and HYDRA-UMC use others on the same machine).
# Behind the HTTPS proxy of docs/DEPLOY.md listen only on this computer (127.0.0.1:18200) and set login_ip_limit = 0.
listen = 0.0.0.0:18200
# Where users, tokens, machines and jobs are kept. Back this folder up.
data_dir = data
# How long a login lasts, in hours.
session_hours = 12
# The largest request (a job with its files), in megabytes.
max_body_mb = 8
# How many finished jobs the list keeps.
keep_jobs = 200
# A folder with the pages of EH3D-STUDIO to serve at / (the configuration panel of this server). Empty: only the API.
studio_dir =
# The folder where the server and the update helper (deploy/eh3d-update.py) meet; with it the Studio can check GitHub for newer releases and update. Empty: no updates.
updates_dir =
# How long, in seconds, a G-code job waits for the machine to finish its last moves (the controller takes lines ahead of the movement) before the job is marked as failed.
gcode_finish_wait_s = 900
# How long, in seconds, a GRBL machine may take to answer a line of a G-code job. When a line does not end in time the machine is held (a homing cycle is reset, a jog is cancelled) and the job is marked as failed, with the line.
# An ordinary line is taken at once.
grbl_line_timeout_s = 5
# How many lines before the one it had reached a resumed G-code job starts again (0 to 1000): the controller takes lines ahead of the movement, so the last ones sent were not all done.
resume_margin_lines = 16
# How many wrong passwords in a row, with any names, block the address they come from for a while (0 to 1000; 0 turns it off). The address is the one of the connection: behind a reverse proxy it is the proxy's, so turn it off there.
login_ip_limit = 10
# Accept the token of the session in the address of the camera and of the websocket (the first versions of the clients sent it there). Off by default: the clients ask for a ticket (POST /api/v1/tickets), good for one use within 30 seconds.
url_token = false
# While the server has no user yet, answer only connections from this very computer (127.0.0.1), so that nobody else on the network can make the first administrator. Off by default (the server answers whoever reaches it); once there is a user it makes no difference.
local_until_setup = false
# The homing cycle ($H, on a machine that allows the $ lines) answers only when the machine has finished; give it more than the longest homing takes.
grbl_homing_timeout_s = 120
# A jog ($J=...) answers when the move is done: give it more than the longest slow move you send.
grbl_jog_timeout_s = 60
# What the server does when a thread of it panics: true stops the machines that are running and exits, so that the service manager (Restart=on-failure) starts it again with its data in order; false only writes the panic to the console and goes on. The conservative choice is true.
exit_on_panic = true
# Take the address of a client from the X-Forwarded-For header, but only on a connection that comes from 127.0.0.1 (the reverse proxy of docs/DEPLOY.md on this very computer); the address the proxy put last is used. Off by default: the address of the socket is the one that counts, and a client that reaches the server directly cannot choose it by writing the header. With it on behind the proxy, login_ip_limit counts each person's own address instead of the proxy's.
trust_forwarded_for = false
# Keep the logins in the data folder (sessions.json, only the SHA-256 of each token) so that a restart of the server (an update, a power cut) does not log anybody out. Off by default: every restart logs everybody out and the file is removed.
persist_sessions = false
# How many days a token of a program lasts when the request that makes it gives no number (0 to 3650; 0: it does not expire). A request can always give its own number of days.
token_default_days = 0
# The websocket of the events sends a ping every events_ping_s seconds (1 to 3600) and is closed when nothing at all, not even the answer to a ping, has come for events_idle_s seconds (longer than events_ping_s).
events_ping_s = 30
events_idle_s = 90
# Write the audit (who did what: logins, jobs, machines, users, tokens, updates) to audit.jsonl in the data folder, one JSON object per line, besides the console. Off: only the console (the journal of the service) has it.
audit_file = true
# Write a line at the start and at the end of every job to eh3d-jobs.log in the data folder (which file, which machine and connection, how it ended, how long it took against the estimate), for diagnosing failures afterwards.
job_log = true
# The size in kilobytes (16 to 1048576) at which audit.jsonl and eh3d-jobs.log are set aside as <name>.1 (one older copy is kept) and a new file starts.
log_max_kb = 1024
# The most places a request may name in the rack of a drilling or routing job, in rack.first and in the entries of rack.slots (1 to 14, the tool changer of the machines has fourteen).
rack_max_slots = 14

# ---- the project store of every application (docs/PROJECT_STORE.md)
# The largest file of a project, in megabytes (1 to 4096), and the most a project may hold counting every distinct version once (1 to 65536).
project_max_file_mb = 64
project_max_mb = 512
# The most files of a project, the most projects of one application, and how many versions of a file are kept (0: all of them).
project_max_files = 2000
project_max_projects = 1000
project_versions_kept = 50
# The longest an editing lock lasts without being renewed, in seconds (10 to 86400).
project_lock_ttl_s = 300
# A write over a file that exists needs If-Match with the tag of the version it was made from (428 without it). Turning this off lets a client overwrite a version it never saw.
project_require_if_match = true
# Team mode: everybody with access to the store sees and writes the projects of the application. Off: only the owner of a project and the administrators.
project_shared = false

# ---- the shared catalogs (docs/CATALOGS.md)
# The largest dataset an administrator may upload to a catalog, in megabytes (1 to 1024), the most items of a dataset, and the most items one page answers with.
catalog_max_mb = 16
catalog_max_items = 100000
catalog_page_max = 200
